{
  "name": "@moonwave99/goffre",
  "version": "0.1.1",
  "description": "Mini static site generator",
  "author": {
    "name": "Diego Caponera",
    "email": "hello@diegocaponera.com",
    "url": "https://github.com/moonwwave99"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonwave99/goffre.git"
  },
  "homepage": "https://moonwave99.github.io/goffre",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "ava **/*.test.ts",
    "lint": "pnpm eslint ./lib --ext .js,.jsx,.ts,.tsx"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsimp"
    ],
    "environmentVariables": {
      "TSIMP_DIAG": "ignore"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "front-matter",
    "generate",
    "generator",
    "markdown",
    "static",
    "static-site",
    "yaml"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "express": "^4.17.1",
    "express-handlebars": "^8.0.6",
    "fs-extra": "^10.0.0",
    "globby": "^12.0.2",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.3",
    "slugify": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "ava": "^6.4.1",
    "cheerio": "^1.0.0-rc.10",
    "dirname-filename-esm": "^1.1.1",
    "eslint": "^10.0.0",
    "faker": "^5.5.3",
    "globals": "^17.3.0",
    "js-yaml": "^4.1.1",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.1",
    "tsimp": "^2.0.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
